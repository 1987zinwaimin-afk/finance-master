rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing Finance Master cloud sync: a signed-in owner can access only their own finance document.
    match /users/{userId}/finance/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Borrower share links are high-entropy bearer tokens. A borrower can GET one active link
    // by its exact document ID, but cannot list links or change the shared account snapshot.
    match /borrowerShares/{token} {
      allow get: if resource.data.active == true
        || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.accountId is string
        && request.resource.data.snapshot is map;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        function parentShare() {
          return get(/databases/$(database)/documents/borrowerShares/$(token)).data;
        }
        allow read: if parentShare().active == true
          || (request.auth != null && request.auth.uid == parentShare().ownerUid);
        allow create: if request.resource.data.keys().hasOnly([
            'token', 'senderRole', 'senderName', 'text', 'imageData', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'token', 'senderRole', 'senderName', 'text', 'imageData', 'createdAt'
          ])
          && request.resource.data.token == token
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 3000
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() <= 600000
          && (request.resource.data.createdAt is timestamp
              || request.resource.data.createdAt == request.time)
          && (
            (request.auth != null
              && request.auth.uid == parentShare().ownerUid
              && parentShare().active == true
              && request.resource.data.senderRole == 'owner')
            ||
            (request.auth == null
              && parentShare().active == true
              && request.resource.data.senderRole == 'borrower')
          );
        // Editing is limited to the original sender and only changes message text.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 3000
          && request.resource.data.token == resource.data.token
          && request.resource.data.senderRole == resource.data.senderRole
          && request.resource.data.senderName == resource.data.senderName
          && request.resource.data.imageData == resource.data.imageData
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (request.auth != null
              && request.auth.uid == parentShare().ownerUid
              && parentShare().active == true
              && resource.data.senderRole == 'owner')
            ||
            (request.auth == null
              && parentShare().active == true
              && resource.data.senderRole == 'borrower')
          );
        // Delete removes the shared document, so both sides see it disappear.
        // Owner can remove either side's message; borrower can remove their own.
        allow delete: if parentShare().active == true
          && (
            (request.auth != null && request.auth.uid == parentShare().ownerUid)
            ||
            (request.auth == null && resource.data.senderRole == 'borrower')
          );
      }
    }

    // Borrowers may submit a new payment request only for the account behind their active token.
    // They cannot read, edit, or delete requests. Only the owner can read and review them.
    match /borrowerPaymentRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'token', 'ownerUid', 'accountId', 'borrowerName', 'currency',
          'amount', 'date', 'apply', 'note', 'paymentMethod', 'receiptImage',
          'status', 'createdAt', 'schemaVersion'
        ])
        && request.resource.data.keys().hasAll([
          'token', 'ownerUid', 'accountId', 'borrowerName', 'currency',
          'amount', 'date', 'apply', 'note', 'paymentMethod', 'receiptImage',
          'status', 'createdAt', 'schemaVersion'
        ])
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/borrowerShares/$(request.resource.data.token))
        && get(/databases/$(database)/documents/borrowerShares/$(request.resource.data.token)).data.active == true
        && get(/databases/$(database)/documents/borrowerShares/$(request.resource.data.token)).data.ownerUid == request.resource.data.ownerUid
        && get(/databases/$(database)/documents/borrowerShares/$(request.resource.data.token)).data.accountId == request.resource.data.accountId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.apply in ['auto', 'interest', 'principal']
        && request.resource.data.paymentMethod in ['cash', 'bank']
        && request.resource.data.receiptImage is string
        && request.resource.data.receiptImage.size() <= 400000
        && ((request.resource.data.paymentMethod == 'cash'
              && request.resource.data.receiptImage == '')
            || (request.resource.data.paymentMethod == 'bank'
              && request.resource.data.receiptImage.size() > 0))
        && request.resource.data.status == 'pending'
        && request.resource.data.schemaVersion == 1;
      allow read: if (
          request.auth != null
          && resource.data.ownerUid == request.auth.uid
        ) || (
          resource.data.token is string
          && exists(/databases/$(database)/documents/borrowerShares/$(resource.data.token))
          && get(/databases/$(database)/documents/borrowerShares/$(resource.data.token)).data.active == true
          && get(/databases/$(database)/documents/borrowerShares/$(resource.data.token)).data.accountId == resource.data.accountId
        );
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason'])
        && (!request.resource.data.keys().hasAny(['rejectionReason']) || (request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 500))
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}